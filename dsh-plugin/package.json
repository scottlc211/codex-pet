{
  "name": "dsh-codex-pet-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness (dsh) host plugin: forwards agent turn / tool progress into the Codex Pet hook inbox, so the desktop pet reacts to dsh runs. Zero dependencies, zero build.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/test-harness.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "codex-pet",
    "desktop-pet",
    "agent-monitor"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
